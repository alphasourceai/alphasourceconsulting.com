{
  "version": 1,
  "staticPublishPath": "artifacts/alphasource-consulting/dist/public",
  "publicRoutes": [
    "/",
    "/dental-consulting",
    "/how-it-works",
    "/for-dental-groups",
    "/practice-opportunity-review",
    "/faq",
    "/security",
    "/support",
    "/analyzer",
    "/about",
    "/privacy",
    "/terms"
  ],
  "publicRedirects": [
    { "source": "/dental-consulting/", "destination": "/dental-consulting", "status": 301 },
    { "source": "/how-it-works/", "destination": "/how-it-works", "status": 301 },
    { "source": "/for-dental-groups/", "destination": "/for-dental-groups", "status": 301 },
    { "source": "/practice-opportunity-review/", "destination": "/practice-opportunity-review", "status": 301 },
    { "source": "/faq/", "destination": "/faq", "status": 301 },
    { "source": "/security/", "destination": "/security", "status": 301 },
    { "source": "/support/", "destination": "/support", "status": 301 },
    { "source": "/analyzer/", "destination": "/analyzer", "status": 301 },
    { "source": "/about/", "destination": "/about", "status": 301 },
    { "source": "/privacy/", "destination": "/privacy", "status": 301 },
    { "source": "/privacy-policy", "destination": "/privacy", "status": 301 },
    { "source": "/privacy-policy/", "destination": "/privacy", "status": 301 },
    { "source": "/terms/", "destination": "/terms", "status": 301 },
    { "source": "/terms-and-conditions", "destination": "/terms", "status": 301 },
    { "source": "/terms-and-conditions/", "destination": "/terms", "status": 301 }
  ],
  "publicRewrites": [
    { "source": "/dental-consulting", "destination": "/dental-consulting/index.html", "status": 200 },
    { "source": "/how-it-works", "destination": "/how-it-works/index.html", "status": 200 },
    { "source": "/for-dental-groups", "destination": "/for-dental-groups/index.html", "status": 200 },
    { "source": "/practice-opportunity-review", "destination": "/practice-opportunity-review/index.html", "status": 200 },
    { "source": "/faq", "destination": "/faq/index.html", "status": 200 },
    { "source": "/security", "destination": "/security/index.html", "status": 200 },
    { "source": "/support", "destination": "/support/index.html", "status": 200 },
    { "source": "/analyzer", "destination": "/analyzer/index.html", "status": 200 },
    { "source": "/about", "destination": "/about/index.html", "status": 200 },
    { "source": "/privacy", "destination": "/privacy/index.html", "status": 200 },
    { "source": "/terms", "destination": "/terms/index.html", "status": 200 }
  ],
  "dynamicSpaRewrites": [
    { "source": "/agreements/*", "destination": "/spa-shell.html", "status": 200 },
    { "source": "/payment-success", "destination": "/spa-shell.html", "status": 200 },
    { "source": "/payment-cancel", "destination": "/spa-shell.html", "status": 200 }
  ],
  "catchAll": { "source": "/*", "destination": "/spa-shell.html", "status": 200 }
}
