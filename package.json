{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "rm -f package-lock.json yarn.lock",
    "build": "pnpm run typecheck && pnpm --filter @workspace/alphasource-consulting run build",
    "typecheck": "pnpm --filter @workspace/alphasource-consulting run typecheck",
    "dev:admin": "pnpm --filter @workspace/alphasource-consulting-admin run dev",
    "build:admin": "pnpm --filter @workspace/alphasource-consulting-admin run build",
    "typecheck:admin": "pnpm --filter @workspace/alphasource-consulting-admin run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
